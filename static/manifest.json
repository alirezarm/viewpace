{
  "manifest_version": 3,
  "name": "ViewPace",
  "version": "0.1.0",
  "description": "Automatically speeds up easy parts and slows down when content needs more attention.",
  "minimum_chrome_version": "138",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "ViewPace" },
  "commands": {
    "toggle-autospeed": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Turn ViewPace on or off"
    }
  }
}
